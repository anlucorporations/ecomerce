# ============================================================
# compra-stablecoin — Variables de entorno (copiar a .env.local)
# ============================================================
# Red local Anvil (desarrollo). En producción: RPC de la red real.
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHAIN_ID=31337

# Direcciones de contratos desplegados
NEXT_PUBLIC_ECOMMERCE_MAIN_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
NEXT_PUBLIC_EURO_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# URLs de las otras apps
NEXT_PUBLIC_WEB_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_WEB_CUSTOMER_URL=http://localhost:3001
NEXT_PUBLIC_PASARELA_URL=http://localhost:3002
NEXT_PUBLIC_COMPRA_STABLECOIN_URL=http://localhost:3003

# ⚠️ OBLIGATORIAS para emitir EURT con pago real (sin ellas NO se mintea nada):
# STRIPE_SECRET_KEY=sk_live_...   (o sk_test_... en pruebas)
# STRIPE_WEBHOOK_SECRET=whsec_... (firma de webhooks — obligatoria)
# ⚠️ OBLIGATORIA: clave del relayer con rol MINTER del token EuroTokenOptimized
# RELAYER_PRIVATE_KEY=0x...
# (alias aceptado: ANVIL_PRIVATE_KEY)

# CORS permitidos (separados por coma) — restringir en producción
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Simulador de webhook (SOLO desarrollo — si no se activa, el endpoint responde 404)
# ENABLE_SIMULATOR=true
# SIMULATOR_TOKEN=token-seguro-de-desarrollo
# NEXT_PUBLIC_ENABLE_SIMULATOR=true
# NEXT_PUBLIC_SIMULATOR_TOKEN=token-seguro-de-desarrollo
