# pasarela-de-pago — Pasarela Web3 Escrow
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED 1
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_ECOMMERCE_MAIN_ADDRESS
ARG NEXT_PUBLIC_EURO_TOKEN_ADDRESS
ARG NEXT_PUBLIC_WEB_CUSTOMER_URL
ARG NEXT_PUBLIC_PASARELA_URL
ARG NEXT_PUBLIC_COMPRA_STABLECOIN_URL
ENV NEXT_PUBLIC_RPC_URL=${NEXT_PUBLIC_RPC_URL}
ENV NEXT_PUBLIC_CHAIN_ID=${NEXT_PUBLIC_CHAIN_ID}
ENV NEXT_PUBLIC_ECOMMERCE_MAIN_ADDRESS=${NEXT_PUBLIC_ECOMMERCE_MAIN_ADDRESS}
ENV NEXT_PUBLIC_EURO_TOKEN_ADDRESS=${NEXT_PUBLIC_EURO_TOKEN_ADDRESS}
ENV NEXT_PUBLIC_WEB_CUSTOMER_URL=${NEXT_PUBLIC_WEB_CUSTOMER_URL}
ENV NEXT_PUBLIC_PASARELA_URL=${NEXT_PUBLIC_PASARELA_URL}
ENV NEXT_PUBLIC_COMPRA_STABLECOIN_URL=${NEXT_PUBLIC_COMPRA_STABLECOIN_URL}
RUN npx next build --no-lint

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV production
ENV PORT 3002
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3002
CMD ["npm", "start"]
